# Copy to .env. Never commit real credentials.
APP_ENV=development
SHRADDHA_BACKEND_ENABLED=true
# App-to-backend bearer token. Production must use a proper per-user/session auth flow.
SHRADDHA_API_TOKEN=replace-with-a-long-random-secret
# Provider credentials remain on the server only.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite
REQUEST_TIMEOUT_SECONDS=90
MAX_REQUEST_BYTES=1048576
ALLOWED_ORIGINS=*
