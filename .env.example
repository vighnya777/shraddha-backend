# Copy to .env. NEVER commit real credentials.
APP_ENV=development                 # use "production" when deployed (requires SHRADDHA_API_TOKEN)
SHRADDHA_BACKEND_ENABLED=true       # server-side master switch (false => /chat returns 503)

# App-to-backend bearer token. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# A static token inside a distributed APK is NOT sufficient production security; see README.
SHRADDHA_API_TOKEN=replace-with-a-long-random-secret

# Upstream provider (OpenAI-compatible). The key stays on the server only.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite
AI_SUPPORTS_VISION=false            # set true only if AI_MODEL accepts images
ALLOW_CLIENT_MODEL=false            # true => clients may choose the upstream model

CONNECT_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=90          # upstream read timeout
MAX_REQUEST_BYTES=1048576
ALLOWED_ORIGINS=*                   # the Android app does not need CORS; restrict if browsers call this
